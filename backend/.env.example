# --- Supabase (Data Layer, md 5) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Service-role key (server-side only, bypasses RLS) — never ship to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Anon key — used by the frontend dashboard for read + realtime
SUPABASE_ANON_KEY=

# --- Anthropic (Planner + Reviewer, md 3) ---
ANTHROPIC_API_KEY=

# --- Claude Code headless (Coder + Tester, md 3) ---
# Path to the `claude` CLI if not on PATH; leave blank to use PATH
CLAUDE_CLI_PATH=

# --- GitHub (issue ingestion + PR creation, md 3 / 6) ---
# Personal access token for the demo (repo scope). Production = GitHub App.
GITHUB_TOKEN=
# owner/repo the pipeline operates on
GITHUB_REPO=
# Secret configured on the GitHub webhook (issues events)
GITHUB_WEBHOOK_SECRET=

# --- Agent identity (md 4) ---
# Where the four Ed25519 private keys are stored (JSON). Generated by `npm run keys:gen`.
AGENT_KEYS_PATH=./.keys/agents.json

# --- Server ---
PORT=8787
# Local clone path the Coder/Tester operate in
WORKSPACE_DIR=./.workspace
