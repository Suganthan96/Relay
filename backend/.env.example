# --- Supabase (Data Layer, md 5) ---
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Service-role key (server-side only, bypasses RLS) — never ship to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Anon key — used by the frontend dashboard for read + realtime
SUPABASE_ANON_KEY=

# --- Claude Code headless (all four agents, md 3) ---
# Path to the `claude` CLI if not on PATH; leave blank to use PATH.
# Auth comes from the machine's existing Claude Code login — no API key.
CLAUDE_CLI_PATH=

# --- GitHub App (issue ingestion + PR creation, md 3 / 6) ---
# Preferred path: a GitHub App. The repo comes from the webhook payload.
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=./private-key.pem
GITHUB_WEBHOOK_SECRET=
# Only act on issues with this label; blank = every opened issue.
RELAY_ISSUE_LABEL=

# Fallback for the manual `npm run pipeline` CLI when no App is configured:
# a personal access token (repo scope) + a fixed repo.
GITHUB_TOKEN=
GITHUB_REPO=

# --- Agent identity (md 4) ---
# Where the four Ed25519 private keys are stored (JSON). Generated by `npm run keys:gen`.
AGENT_KEYS_PATH=./.keys/agents.json

# --- Server ---
PORT=8787
# Local clone path the Coder/Tester operate in
WORKSPACE_DIR=./.workspace

# --- Sandbox (md 6·2) ---
# local  = run the cloned repo's scripts (npm install/test) on this host
# docker = run them in `docker run --rm --network none` (build: npm run sandbox:build)
SANDBOX=local
SANDBOX_IMAGE=relay-sandbox:latest

# --- Multi-org (md 6·6) ---
# Org every task this instance creates belongs to.
RELAY_ORG=default
# true => enforce org-scoped RLS (also run supabase/enforce-org.sql once)
RELAY_ENFORCE_ORG=false

# --- Escalation notifications (md 6·5) ---
# Flagged reviews are posted here (both optional; blank = no-op).
SLACK_WEBHOOK_URL=
RELAY_NOTIFY_WEBHOOK=
# Used to build the "Decide →" link in notifications.
RELAY_DASHBOARD_URL=http://localhost:3000

# --- Applying migrations when the Postgres pooler is unreachable ---
# A Supabase personal access token (Account -> Access Tokens). Lets
# `npm run db:apply -- <file.sql>` run SQL via the Management API.
SUPABASE_ACCESS_TOKEN=
